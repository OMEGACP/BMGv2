    <selectionEntry type="upgrade" import="true" name="Upgrades" hidden="false" id="b972-3b6f-2150-299b">
      <selectionEntries>
        <selectionEntry type="upgrade" import="true" name="Lobo&apos;s Spacehog" hidden="false" id="7dca-f44f-e9d1-6262">
          <profiles>
            <profile name="Lobo&apos;s Spacehog" typeId="c67d-695d-6a54-1b0f" typeName="Character Upgrade" hidden="false" id="e341-e20c-9e59-5979">
              <characteristics>
                <characteristic name="Upgraded Character" typeId="b514-1c96-4f58-694d">Lobo</characteristic>
                <characteristic name="Alias" typeId="b831-e12b-268f-f459">Lobo&apos;s Spacehog</characteristic>
                <characteristic name="Movement" typeId="523a-d3f9-1dcd-9857">+1</characteristic>
                <characteristic name="Endurance" typeId="22db-2198-71de-7a57">4</characteristic>
                <characteristic name="Upgrade Traits" typeId="7c53-1136-d648-2c7e">Fly, Huge, Swift, Mechanical Mount, Hands-Off Mode</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name=" Dollar" typeId="b5b3-aa8b-4d9c-5673" value="0"/>
            <cost name="Reputation" typeId="99c9-f5c8-7271-b9c6" value="34"/>
          </costs>
          <rules>
            <rule name="Hands-Off Mode" id="035e-53f5-03f8-5970" hidden="false">
              <description>Once per game, this model can activate Hands-off Mode during a Charge. Instead of causing close combat hits to models it moves through, this model may perform a ranged attach against each model. This gains Assault (2) and only consumes 1 Ammo in total.</description>
            </rule>
          </rules>
